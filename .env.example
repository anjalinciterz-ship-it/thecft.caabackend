# These names must match src/config/env.js exactly. env.js boots with zod
# safeParse and throws on any missing required key, so a wrong name is a crash
# on the host, not a warning. Variables marked REQUIRED have no default.

# ---- runtime ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://127.0.0.1:5180
BACKEND_URL=http://127.0.0.1:5000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180
# REQUIRED, at least 32 characters. This is the key that signs the session cookie.
SESSION_SIGNING_KEY=replace-with-32-bytes-of-random-hex

# ---- database ----
# REQUIRED. Use the Atlas connection string on the host; the local dev stack
# spins up its own in-memory database and does not read this.
MONGODB_URI=mongodb://127.0.0.1:27017/cft
# Comma-separated resolvers for hosts where the Atlas SRV lookup needs one.
DNS_SERVERS=

# ---- google sign-in ----
AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
# REQUIRED (env.js has no default for it even when Google is off). Set to the
# real OAuth client secret; leave the flag false if you do not want Google login.
GOOGLE_CLIENT_SIGNIN_KEY=

# ---- other auth methods (all off until decided) ----
AUTH_PASSWORD_ENABLED=false
AUTH_OTP_EMAIL_ENABLED=false
AUTH_MAGIC_LINK_ENABLED=true

# ---- bunny stream ----
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=788236
BUNNY_STREAM_API_HOST=https://video.bunnycdn.com
BUNNY_EMBED_HOST=https://player.mediadelivery.net
BUNNY_SIGNING_KEY=
VIDEO_SESSION_TTL_SECONDS=1800
VIDEO_HEARTBEAT_SECONDS=45
VIDEO_MAX_CONCURRENT_SESSIONS=1
WATERMARK_OPACITY=0.32
WATERMARK_MOVE_SECONDS=7

# ---- payments ----
PAYMENT_PROVIDER=mock
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_KEY=

# ---- email ----
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=Mind Life Academy <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=
